generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DOCTOR
  SECRETARY
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}

model Clinic {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  address      String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  patients     Patient[]
  appointments Appointment[]

  @@index([isActive])
  @@index([name])
}

model Patient {
  id           String        @id @default(cuid())
  name         String
  phone        String
  clinicId     String
  notes        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@index([clinicId])
  @@index([isActive])
  @@index([name])
  @@index([phone])
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  clinicId    String
  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic      Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([clinicId])
  @@index([scheduledAt])
  @@index([status])
}
