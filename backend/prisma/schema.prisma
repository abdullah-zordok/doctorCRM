generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  DOCTOR
  SECRETARY
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VisitStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum PrescriptionStatus {
  ACTIVE
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

model User {
  id                           String                 @id @default(cuid())
  email                        String                 @unique
  name                         String
  passwordHash                 String
  role                         Role
  isActive                     Boolean                @default(true)
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  doctorVisits                 Visit[]                @relation("VisitDoctor")
  visitRevisionsChanged        VisitRevision[]        @relation("VisitRevisionChangedBy")
  doctorPrescriptions          Prescription[]         @relation("PrescriptionDoctor")
  prescriptionRevisionsChanged PrescriptionRevision[] @relation("PrescriptionRevisionChangedBy")
  paymentsReceived             Payment[]              @relation("PaymentReceivedBy")
  paymentRevisionsChanged      PaymentRevision[]      @relation("PaymentRevisionChangedBy")

  @@index([role])
  @@index([isActive])
}

model Clinic {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  address      String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  patients     Patient[]
  appointments Appointment[]
  visits       Visit[]
  payments     Payment[]

  @@index([isActive])
  @@index([name])
}

model Patient {
  id           String        @id @default(cuid())
  name         String
  phone        String
  clinicId     String
  notes        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  visits       Visit[]
  payments     Payment[]

  @@index([clinicId])
  @@index([isActive])
  @@index([name])
  @@index([phone])
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  clinicId    String
  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic      Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([clinicId])
  @@index([scheduledAt])
  @@index([status])
}

model Visit {
  id            String          @id @default(cuid())
  patientId     String
  clinicId      String
  doctorId      String
  visitDate     DateTime
  diagnosis     String
  treatment     String
  status        VisitStatus     @default(OPEN)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  patient       Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic        Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor        User            @relation("VisitDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  revisions     VisitRevision[]
  prescriptions Prescription[]
  payments      Payment[]

  @@index([patientId])
  @@index([clinicId])
  @@index([doctorId])
  @@index([visitDate])
  @@index([status])
}

model VisitRevision {
  id              String   @id @default(cuid())
  visitId         String
  changedByUserId String
  diagnosis       String
  treatment       String
  notes           String?
  reason          String
  createdAt       DateTime @default(now())
  visit           Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  changedByUser   User     @relation("VisitRevisionChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([visitId])
  @@index([changedByUserId])
}

model Prescription {
  id           String                 @id @default(cuid())
  visitId      String
  doctorId     String
  medications  Json
  instructions String
  status       PrescriptionStatus     @default(ACTIVE)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  visit        Visit                  @relation(fields: [visitId], references: [id], onDelete: Restrict)
  doctor       User                   @relation("PrescriptionDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  revisions    PrescriptionRevision[]

  @@index([visitId])
  @@index([doctorId])
  @@index([status])
}

model PrescriptionRevision {
  id              String       @id @default(cuid())
  prescriptionId  String
  changedByUserId String
  medications     Json
  instructions    String
  reason          String
  createdAt       DateTime     @default(now())
  prescription    Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  changedByUser   User         @relation("PrescriptionRevisionChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([prescriptionId])
  @@index([changedByUserId])
}

model Payment {
  id               String            @id @default(cuid())
  patientId        String
  visitId          String?
  clinicId         String
  receivedByUserId String
  totalAmount      Decimal
  paidAmount       Decimal
  remainingAmount  Decimal
  method           PaymentMethod
  paidAt           DateTime
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visit            Visit?            @relation(fields: [visitId], references: [id], onDelete: SetNull)
  clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  receivedByUser   User              @relation("PaymentReceivedBy", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  revisions        PaymentRevision[]

  @@index([patientId])
  @@index([visitId])
  @@index([clinicId])
  @@index([receivedByUserId])
  @@index([paidAt])
}

model PaymentRevision {
  id              String        @id @default(cuid())
  paymentId       String
  changedByUserId String
  totalAmount     Decimal
  paidAmount      Decimal
  remainingAmount Decimal
  method          PaymentMethod
  reason          String
  createdAt       DateTime      @default(now())
  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  changedByUser   User          @relation("PaymentRevisionChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([changedByUserId])
}
